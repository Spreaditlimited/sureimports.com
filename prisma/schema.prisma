model seo_change_rewrite_artifacts {
  id                  Int       @id @default(autoincrement())
  pidArtifact         String    @unique() @db.VarChar(80)
  pidChange           String    @unique() @db.VarChar(80)
  sourceContentHash   String    @db.Char(64)
  rewrittenHtml       String?   @db.LongText
  appliedChangesJson  String?   @db.LongText
  discoveredLinksJson String?   @db.LongText
  pendingLinksJson    String?   @db.LongText
  decisionsJson       String?   @db.LongText
  externalLinkChangesJson String? @db.LongText
  qualityPolicyVersion    String? @db.VarChar(80)
