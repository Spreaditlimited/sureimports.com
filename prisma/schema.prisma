  openAiModel             String? @db.VarChar(80)
  status              String    @default("rewriting") @db.VarChar(40)
  errorCode           String?   @db.VarChar(80)
  errorMessage        String?   @db.Text
  attemptCount        Int       @default(0)
  generatedAt         DateTime?
  reviewedAt          DateTime?
  appliedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
}

model seo_change_pipeline_attempts {
  id           Int       @id @default(autoincrement())
  pidAttempt   String    @unique() @db.VarChar(80)
  pidChange    String    @db.VarChar(80)
  stage        String    @db.VarChar(40)
  status       String    @default("started") @db.VarChar(40)
  errorCode    String?   @db.VarChar(80)
  errorMessage String?   @db.Text
  detailsJson  String?   @db.LongText
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([pidChange, stage])
  @@index([status])
}

