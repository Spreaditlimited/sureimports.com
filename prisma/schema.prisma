// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Shared affiliate-program tables. These are managed by the affiliate/admin
// applications, but the main storefront needs this projection to securely
// record and resolve referral attribution.
model affiliate_accounts {
  id                   Int                             @id @default(autoincrement())
  emailHash            String                          @unique @db.Char(64)
  emailCiphertext      String                          @db.Text
  firstNameCiphertext  String                          @db.Text
  referralCode         String                          @unique @db.VarChar(24)
  status               String                          @default("PENDING_VERIFICATION") @db.VarChar(32)
  referrals            affiliate_referrals[]
  conversions          affiliate_conversions[]
  payouts              affiliate_payouts[]
  apiCredentials       affiliate_api_credentials[]
  shippingAttributions shipping_request_attributions[]
  externalIdentities   affiliate_external_identities[]
  referralAliases      affiliate_referral_code_aliases[]
}

model affiliate_program_services {
  id                  Int                                  @id @default(autoincrement())
  pidService          String                               @unique @db.VarChar(80)
  serviceKey          String                               @unique @db.VarChar(80)
  displayName         String                               @db.VarChar(140)
  description         String?                              @db.Text
  commissionType      String                               @db.VarChar(24)
  percentageRate      Decimal?                             @db.Decimal(7, 4)
  eligibleAmountBasis String                               @db.VarChar(40)
  recurring           Boolean                              @default(false)
  approvalMode        String                               @default("MANUAL") @db.VarChar(24)
  reviewPeriodDays    Int                                  @default(14)
  exclusionNotes      String?                              @db.Text
  active              Boolean                              @default(true)
  sortOrder           Int                                  @default(0)
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt
  currencyRates       affiliate_service_commission_rates[]
  unitRates           affiliate_service_unit_rates[]
  conversions         affiliate_conversions[]
  eventRules          affiliate_service_event_rules[]

  @@index([active, sortOrder])
}

model affiliate_service_event_rules {
  id                  Int                         @id @default(autoincrement())
  pidEventRule        String                      @unique @db.VarChar(80)
  serviceId           Int
  eventKey            String                      @db.VarChar(80)
  displayName         String                      @db.VarChar(140)
  description         String?                     @db.Text
  commissionType      String                      @default("PERCENTAGE") @db.VarChar(24)
  percentageRate      Decimal?                    @db.Decimal(7, 4)
  eligibleAmountBasis String                      @default("PRODUCT_OR_SERVICE_AMOUNT") @db.VarChar(40)
  active              Boolean                     @default(true)
  sortOrder           Int                         @default(0)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  service             affiliate_program_services @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, eventKey], map: "affiliate_service_event_rule_key")
  @@index([serviceId, active, sortOrder])
}

model affiliate_external_identities {
  id                  Int                @id @default(autoincrement())
  pidIdentity         String             @unique @db.VarChar(80)
  affiliateId         Int
  sourceSystem        String             @db.VarChar(40)
  externalAffiliateId String             @db.VarChar(120)
  createdAt           DateTime           @default(now())
  affiliate           affiliate_accounts @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, externalAffiliateId], map: "affiliate_external_identity_key")
  @@index([affiliateId, sourceSystem])
}

model affiliate_referral_code_aliases {
  id           Int                @id @default(autoincrement())
  pidAlias     String             @unique @db.VarChar(80)
  affiliateId  Int
  sourceSystem String             @db.VarChar(40)
  aliasCode    String             @db.VarChar(40)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  affiliate    affiliate_accounts @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([sourceSystem, aliasCode], map: "affiliate_referral_alias_key")
  @@index([affiliateId, active])
}

model affiliate_service_unit_rates {
  id                 Int                        @id @default(autoincrement())
  serviceId          Int
  currency           String                     @db.Char(3)
  billingUnit        String                     @db.VarChar(16)
  destinationCountry String                     @default("*") @db.VarChar(100)
  shippingMode       String                     @default("*") @db.VarChar(24)
  unitRate           Decimal                    @db.Decimal(18, 4)
  active             Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  service            affiliate_program_services @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, currency, billingUnit, destinationCountry, shippingMode], map: "affiliate_unit_rate_scope_key")
  @@index([serviceId, currency, billingUnit, active], map: "affiliate_unit_rate_lookup_idx")
}

model affiliate_service_commission_rates {
  id             Int                        @id @default(autoincrement())
  serviceId      Int
  currency       String                     @db.Char(3)
  fixedAmount    Decimal?                   @db.Decimal(18, 2)
  percentageRate Decimal?                   @db.Decimal(7, 4)
  active         Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  service        affiliate_program_services @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, currency])
  @@index([currency, active])
}

model affiliate_referrals {
  id                   Int                             @id @default(autoincrement())
  pidReferral          String                          @unique @db.VarChar(80)
  affiliateId          Int
  visitorHash          String                          @db.Char(64)
  landingPath          String                          @db.VarChar(500)
  source               String?                         @db.VarChar(255)
  customerReference    String?                         @unique @db.VarChar(191)
  firstTouchAt         DateTime                        @default(now())
  lastTouchAt          DateTime                        @default(now())
  claimedAt            DateTime?
  convertedAt          DateTime?
  affiliate            affiliate_accounts              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  conversions          affiliate_conversions[]
  shippingAttributions shipping_request_attributions[]

  @@index([affiliateId, firstTouchAt])
  @@index([visitorHash, lastTouchAt])
}

model affiliate_conversions {
  refundAdjustments        affiliate_refund_adjustments[]
  id                       Int                        @id @default(autoincrement())
  pidConversion            String                     @unique @db.VarChar(80)
  affiliateId              Int
  serviceId                Int
  referralId               Int?
  externalOrderReference   String                     @db.VarChar(120)
  externalPaymentReference String?                    @unique @db.VarChar(160)
  paymentCurrency          String                     @db.Char(3)
  grossAmount              Decimal                    @db.Decimal(18, 2)
  eligibleAmount           Decimal                    @db.Decimal(18, 2)
  commissionCurrency       String                     @db.Char(3)
  commissionAmount         Decimal                    @db.Decimal(18, 2)
  commissionBasisUnit      String?                    @db.VarChar(16)
  commissionBasisQuantity  Decimal?                   @db.Decimal(18, 4)
  commissionRate           Decimal?                   @db.Decimal(18, 4)
  status                   String                     @default("PENDING") @db.VarChar(24)
  releaseMode              String                     @default("MANUAL") @db.VarChar(24)
  releaseAt                DateTime?
  approvedAt               DateTime?
  availableAt              DateTime?
  voidedAt                 DateTime?
  reversedFromStatus       String?                    @db.VarChar(24)
  reversalReason           String?                    @db.Text
  reversalReference        String?                    @db.VarChar(160)
  sourceSystem             String                     @default("SURE_IMPORTS") @db.VarChar(40)
  sourceEventKey           String?                    @db.VarChar(80)
  paymentLedgerEntryId     Int?                       @unique
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  affiliate                affiliate_accounts         @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  service                  affiliate_program_services @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  referral                 affiliate_referrals?       @relation(fields: [referralId], references: [id], onDelete: SetNull)
  payoutItem               affiliate_payout_items?
  paymentLedgerEntry       payment_ledger_entries?    @relation(fields: [paymentLedgerEntryId], references: [id], onDelete: SetNull)

  @@unique([externalOrderReference, serviceId])
  @@index([affiliateId, status, createdAt])
  @@index([serviceId, createdAt])
  @@index([status, releaseAt])
}

model payment_ledger_entries {
  id                       Int                    @id @default(autoincrement())
  pidLedgerEntry           String                 @unique @db.VarChar(80)
  sourceSystem             String                 @db.VarChar(40)
  sourcePaymentType        String                 @db.VarChar(80)
  sourcePaymentId          String                 @db.VarChar(160)
  sourceOrderReference     String?                @db.VarChar(160)
  customerReference        String?                @db.VarChar(191)
  purpose                  String                 @db.VarChar(80)
  provider                 String?                @db.VarChar(40)
  providerReference        String?                @db.VarChar(191)
  status                   String                 @db.VarChar(24)
  originalCurrency         String                 @db.Char(3)
  originalAmount           Decimal                @db.Decimal(18, 2)
  eligibleAmount           Decimal                @db.Decimal(18, 2)
  settlementCurrency       String?                @db.Char(3)
  settlementAmount         Decimal?               @db.Decimal(18, 2)
  fxRate                   Decimal?               @db.Decimal(18, 8)
  fxSource                 String?                @db.VarChar(80)
  fxCapturedAt             DateTime?
  billingUnit              String?                @db.VarChar(16)
  eligibleQuantity         Decimal?               @db.Decimal(18, 4)
  destinationCountry       String?                @db.VarChar(100)
  shippingMode             String?                @db.VarChar(24)
  occurredAt               DateTime
  metadataJson             String?                @db.LongText
  processingStatus         String                 @default("PENDING") @db.VarChar(24)
  processingError          String?                @db.VarChar(1000)
  processedAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  events                   payment_ledger_events[]
  conversion               affiliate_conversions?

  @@unique([sourceSystem, sourcePaymentType, sourcePaymentId], map: "payment_ledger_source_key")
  @@index([status, occurredAt])
  @@index([customerReference, occurredAt])
  @@index([providerReference])
  @@index([processingStatus, updatedAt])
}

model payment_ledger_events {
  id              Int                     @id @default(autoincrement())
  pidLedgerEvent  String                  @unique @db.VarChar(80)
  externalEventId String                  @unique @db.VarChar(191)
  ledgerEntryId   Int?
  sourceSystem    String                  @db.VarChar(40)
  eventType       String                  @db.VarChar(40)
  payloadHash     String                  @db.Char(64)
  payloadJson     String                  @db.LongText
  receivedAt      DateTime                @default(now())
  processedAt     DateTime?
  processingError String?                 @db.VarChar(1000)
  ledgerEntry     payment_ledger_entries? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)

  @@index([sourceSystem, receivedAt])
  @@index([ledgerEntryId])
}

model affiliate_api_credentials {
  id               Int                             @id @default(autoincrement())
  pidCredential    String                          @unique @db.VarChar(80)
  affiliateId      Int
  name             String                          @db.VarChar(120)
  keyPrefix        String                          @db.VarChar(24)
  keyHash          String                          @unique @db.Char(64)
  scopes           String                          @default("shipping:write") @db.VarChar(255)
  active           Boolean                         @default(true)
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  createdByPidUser String?                         @db.VarChar(80)
  revokedAt        DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  affiliate        affiliate_accounts              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  idempotency      affiliate_api_idempotency[]
  shippingRequests shipping_request_attributions[]

  @@index([affiliateId, active])
  @@index([keyPrefix, active])
}

model affiliate_api_idempotency {
  id             Int                       @id @default(autoincrement())
  credentialId   Int
  idempotencyKey String                    @db.VarChar(120)
  requestHash    String                    @db.Char(64)
  responseStatus Int
  responseBody   String                    @db.LongText
  createdAt      DateTime                  @default(now())
  expiresAt      DateTime
  credential     affiliate_api_credentials @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, idempotencyKey], map: "affiliate_api_idempotency_credential_key")
  @@index([expiresAt])
}

model shipping_request_attributions {
  id              Int                        @id @default(autoincrement())
  pidAttribution  String                     @unique @db.VarChar(80)
  pidShippingOnly String                     @unique @db.VarChar(191)
  affiliateId     Int
  referralId      Int?
  apiCredentialId Int?
  sourceType      String                     @db.VarChar(32)
  sourceReference String?                    @db.VarChar(191)
  lockedAt        DateTime                   @default(now())
  createdAt       DateTime                   @default(now())
  affiliate       affiliate_accounts         @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  referral        affiliate_referrals?       @relation(fields: [referralId], references: [id], onDelete: SetNull)
  apiCredential   affiliate_api_credentials? @relation(fields: [apiCredentialId], references: [id], onDelete: SetNull)
  shippingRequest shipping_only              @relation(fields: [pidShippingOnly], references: [pidShippingOnly], onDelete: Cascade)

  @@unique([affiliateId, sourceType, sourceReference], map: "shipping_attribution_partner_reference_key")
  @@index([affiliateId, createdAt])
  @@index([referralId])
  @@index([apiCredentialId])
}

model affiliate_payouts {
  refundAdjustments affiliate_refund_adjustments[]
  id                Int                      @id @default(autoincrement())
  pidPayout         String                   @unique @db.VarChar(80)
  affiliateId       Int
  provider          String                   @db.VarChar(24)
  currency          String                   @db.Char(3)
  amount            Decimal                  @db.Decimal(18, 2)
  status            String                   @default("REQUESTED") @db.VarChar(24)
  externalReference String?                  @unique @db.VarChar(180)
  providerStatus    String?                  @db.VarChar(80)
  failureReason     String?                  @db.VarChar(500)
  affiliate         affiliate_accounts       @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  items             affiliate_payout_items[]
}

model affiliate_payout_items {
  id           Int                   @id @default(autoincrement())
  payoutId     Int
  conversionId Int                   @unique
  payout       affiliate_payouts     @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  conversion   affiliate_conversions @relation(fields: [conversionId], references: [id], onDelete: Restrict)

  @@index([payoutId])
}

model affiliate_refund_adjustments {
  refundId     String   @db.VarChar(191)
  conversionId Int
  amount       Decimal  @db.Decimal(18, 2)
  currency     String   @db.Char(3)
  payoutId     Int?
  createdAt    DateTime @default(now()) @db.DateTime(3)
  conversion   affiliate_conversions @relation(fields: [conversionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "affiliate_refund_adjustments_conversion_fk")
  payout       affiliate_payouts? @relation(fields: [payoutId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "affiliate_refund_adjustments_payout_fk")

  @@id([refundId, conversionId])
  @@index([payoutId], map: "affiliate_refund_adjustments_payout")
  @@index([conversionId], map: "affiliate_refund_adjustments_conversion")
}

model affiliate_email_events {
  id            Int       @id @default(autoincrement())
  pidEvent      String    @unique @db.VarChar(80)
  eventKey      String    @unique @db.VarChar(191)
  eventType     String    @db.VarChar(80)
  recipientHash String    @db.Char(64)
  status        String    @default("PENDING") @db.VarChar(24)
  attempts      Int       @default(1)
  lockedAt      DateTime?
  sentAt        DateTime?
  lastError     String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([recipientHash, createdAt])
}

model sub {
  id            Int       @id @default(autoincrement())
  pidBlog       String    @unique(map: "Blog_pidBlog_key")
  blogTitle     String    @db.VarChar(255)
  blogContent   String?
  blogSlug      String?
  blogPublished Boolean   @default(false)
  blogImage     String?
  blogBy        String?
  blogExt1      String?
  blogExt2      String?
  xStaus        String?
  createdAt     DateTime? @default(now())
  updatedAt     DateTime?
}

